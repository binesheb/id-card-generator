{
  "name": "jayalakshmi-id-card-generator",
  "version": "0.2.0",
  "description": "Windows desktop ID card generator with a production-focused visual editor and overlay-based employee card printing.",
  "main": "electron-main.js",
  "author": "binesheb",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check app.js && node --check electron-main.js && node --check preload.js && node --check updater-renderer.js",
    "test": "npm run check && node tests/smoke-check.js",
    "dist": "npm run test && electron-builder --win nsis portable --publish never",
    "dist:installer": "npm run test && electron-builder --win nsis --publish never",
    "dist:portable": "npm run test && electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "in.jayalakshmi.idcardgenerator",
    "productName": "Jayalakshmi ID Card Generator",
    "directories": { "output": "dist" },
    "asar": true,
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "ui-enhancements.css",
      "layer-order.css",
      "electron-main.js",
      "preload.js",
      "updater-renderer.js",
      "assets/**/*",
      "README.md",
      "TEMPLATE.md",
      "CHANGELOG.md",
      "VERSIONING.md",
      "fonts/**/*"
    ],
    "publish": [{ "provider": "github", "owner": "binesheb", "repo": "id-card-generator", "releaseType": "release" }],
    "win": { "target": ["nsis", "portable"] },
    "nsis": {
      "artifactName": "Jayalakshmi-ID-Card-Generator-${version}-${arch}-Setup.${ext}",
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "portable": { "artifactName": "Jayalakshmi-ID-Card-Generator-${version}-${arch}-Portable.${ext}" }
  }
}
