{
  "name": "jayalakshmi-id-card-generator",
  "version": "0.1.1",
  "description": "Windows desktop ID card generator for overlay-based employee card printing.",
  "main": "electron-main.js",
  "author": "binesheb",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "check": "node --check app.js && node --check electron-main.js && node --check preload.js",
    "dist": "electron-builder --win nsis portable",
    "dist:installer": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "in.jayalakshmi.idcardgenerator",
    "productName": "Jayalakshmi ID Card Generator",
    "directories": {
      "output": "dist"
    },
    "files": [
      "index.html",
      "app.js",
      "styles.css",
      "electron-main.js",
      "preload.js",
      "README.md",
      "TEMPLATE.md"
    ],
    "asar": true,
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "Jayalakshmi-ID-Card-Generator-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
